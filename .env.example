# Copiar este archivo como .env.local en desarrollo,
# y cargar las mismas variables en Vercel (Project Settings → Environment Variables) para producción.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Esta clave NUNCA lleva el prefijo NEXT_PUBLIC_ — así el navegador nunca la ve,
# solo el servidor la usa (en app/api/summarize).
ANTHROPIC_API_KEY=
